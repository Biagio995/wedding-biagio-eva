{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "framework": null,
    "installCommand": "cp laravel/composer.lock composer.lock 2>/dev/null || true && cd laravel && npm ci",
    "buildCommand": "cd laravel && npm run build",
    "outputDirectory": "laravel/public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "excludeFiles": "{laravel/node_modules/**,laravel/tools/**,laravel/tests/**,laravel/storage/logs/**,laravel/.playwright-mcp/**,laravel/docker/**,laravel/Dockerfile,laravel/.dockerignore,laravel/.phpunit.result.cache,laravel/phpunit.xml,laravel/README.md,laravel/public/hot}"
        }
    },
    "routes": [
        {
            "src": "/build/assets/(.*)",
            "dest": "/laravel/public/build/assets/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/laravel/public/images/$1"
        },
        {
            "src": "/audio/(.*)",
            "dest": "/laravel/public/audio/$1"
        },
        {
            "src": "/storage/(.*)",
            "dest": "/laravel/public/storage/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/laravel/public/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/laravel/public/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "CACHE_DRIVER": "array",
        "CACHE_STORE": "array",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "error",
        "QUEUE_CONNECTION": "sync",
        "SESSION_DRIVER": "cookie",
        "VIEW_COMPILED_PATH": "/tmp",
        "DB_CONNECTION": "pgsql"
    }
}
